{
  "name": "krillion-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fallback": "tsc --noEmit && VITE_PAGES_FALLBACK=1 BASE_PATH=/Krillion-Practice/public/ vite build && rm -rf public/assets && mkdir -p public/assets && cp page-fallback/assets/* public/assets/",
    "preview": "vite preview",
    "bank": "node scripts/build-bank.mjs && node scripts/build-lexicon.mjs",
    "lexicon": "node scripts/build-lexicon.mjs",
    "test:solver": "node scripts/test/eval-solver.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
